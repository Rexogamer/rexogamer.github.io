---
// i would happily use regular fedi/mail icons but simple-icons doesn't have either. better than just calling it all mastodon 🧌
import BlueskyIcon from "../components/icons/Bluesky.astro";
import FirefishIcon from "../components/icons/Firefish.astro";
import GitHubIcon from "../components/icons/GitHub.astro";
import GmailIcon from "../components/icons/Gmail.astro";
import MatrixIcon from "../components/icons/Matrix.astro";
import RevoltIcon from "../components/icons/Revolt.astro";

const today = new Date();
---

<footer>
    &copy; {today.getFullYear()} Sophie L
    <div class="social-links">
        <a href="https://st.transbus.social/@rexo" target="_blank">
            <span class="sr-only">Follow me on the Fediverse</span>
            <FirefishIcon />
        </a>
        <a href="https://bsky.app/profile/rexowo.dev" target="_blank">
            <span class="sr-only">Follow me on Bluesky</span>
            <BlueskyIcon />
        </a>
        <a href="https://github.com/rexogamer" target="_blank">
            <span class="sr-only">View my GitHub profile</span>
            <GitHubIcon />
        </a>
        <a href="https://rvlt.gg/rexo" target="_blank">
            <span class="sr-only">Join my Revolt server</span>
            <RevoltIcon />
        </a>
        <a href="https://matrix.to/#/@rexogamer:mozilla.org" target="_blank">
            <span class="sr-only">Message me on Matrix</span>
            <MatrixIcon />
        </a>
        <a
            href="mailto:beartechtalks@gmail.com?subject=[ENQUIRY]&body=(I'm here from your website.)"
            target="_blank">
            <span class="sr-only">Send me an email</span>
            <GmailIcon />
        </a>
    </div>
    <p class="bottom-links">
        <a href="https://github.com/rexogamer/rexogamer.github.io"
            >source code</a
        > • icons from <a href="https://github.com/simple-icons/simple-icons"
            >Simple Icons</a
        >
    </p>
    <div class="bottom-links webrings">
        <p id="webring-sernik">
            <a class="webring-previous" href="https://sneexy.synth.download/">
                <span class="sr-only"
                    >Go to the previous page in the webring</span
                >◀</a
            > • <span class="webring-title"
                ><span class="emoji">🍰💍</span> sernik <span class="emoji"
                    >💍🍰</span
                ></span
            > • <a class="webring-next" href="https://amycatgirl.github.io/"
                >▶<span class="sr-only">Go to the next page in the webring</span
                >
            </a>
        </p>
        <p id="webring-wiki">
            <a
                class="webring-previous"
                href="https://webring.wiki/previous?host=rexowo.dev">
                <span class="sr-only"
                    >Go to the previous page in the webring</span
                >◀</a
            > • <a class="webring-title" href="https://webring.wiki/"
                >webring.wiki</a
            > • <a
                class="webring-next"
                href="https://webring.wiki/next?host=rexowo.dev"
                ><span class="sr-only">Go to the next page in the webring</span
                >▶</a
            >
        </p>
    </div>
</footer>
<style>
    footer {
        padding: 2em 1em;
        background: var(--background-secondary);
        color: var(--text-primary);
        text-align: center;
    }
    .social-links {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1em;
        margin-block: 1em;
    }
    .social-links a {
        text-decoration: none;
        color: var(--text-primary);
    }
    .social-links a:hover {
        color: var(--social-link-hover);
    }
    .bottom-links {
        font-size: 85%;
    }
    .webrings p {
        margin-block: 0.25em;
    }
    .webring-previous,
    .webring-next {
        text-decoration: none;
    }
    .webring-previous {
        margin-inline-end: 0.25em;
    }
    .webring-title {
        color: transparent;
        background-image: linear-gradient(
            90deg,
            var(--accent),
            var(--accent-red)
        );
        background-clip: text;
        display: inline;
        font-weight: bold;
        margin-inline: 0.25em;
    }
    .webring-title .emoji {
        color: var(--text-primary);
    }
    .webring-next {
        color: var(--accent-red);
        margin-inline-start: 0.25em;
    }
</style>
